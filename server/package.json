{
  "name": "flaner-cosmetics-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "npm --prefix ../client ci && npm --prefix ../client run build && npm run build:server",
    "build:server": "esbuild src/server.ts src/db/migrate.ts src/db/seed.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist --out-extension:.js=.cjs",
    "start": "node dist/db/migrate.cjs && node dist/db/seed.cjs && node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit --test-timeout=60000 test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
