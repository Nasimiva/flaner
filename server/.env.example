PORT=3000
NODE_ENV=development

# PostgreSQL connection for migrations, seed, and the Express product API.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flaner_cosmetics
DATABASE_SSL=false

# In production, list the exact origins of separately hosted browser clients.
CORS_ORIGINS=https://your-storefront.example,https://your-mini-app.example

# Existing Telegram and admin credentials are configured privately in the host environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=
ADMIN_EMAIL_ALLOWLIST=
